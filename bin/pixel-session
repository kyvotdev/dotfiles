#!/bin/sh
export PATH="$HOME/.local/bin:$PATH"
export QT_QPA_PLATFORMTHEME=qt6ct
# Native Pixel Shell menus replace the legacy tray applet.
pkill -u "$(id -u)" -x nm-applet 2>/dev/null || true
systemctl --user import-environment WAYLAND_DISPLAY DISPLAY NIRI_SOCKET XDG_CURRENT_DESKTOP QT_QPA_PLATFORMTHEME
systemctl --user start pixel-bluetooth.service
pixel-theme --restore
if command -v mako >/dev/null 2>&1; then
    pgrep -u "$(id -u)" -x mako >/dev/null || mako &
fi
systemctl --user start pixel-idle.service pixel-sleep-lock.service pixel-display-watch.service pixel-clipboard-text.service pixel-clipboard-image.service
wait
