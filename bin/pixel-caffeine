#!/usr/bin/env python3
import json,subprocess,sys,signal,os
UNIT='pixel-idle.service'
def state():return subprocess.run(['systemctl','--user','is-active',UNIT],capture_output=True,text=True)
def main():
    result=state();enabled=result.returncode==3 and result.stdout.strip()=='inactive'
    if len(sys.argv)>1 and sys.argv[1]=='toggle':
        if result.returncode not in (0,3):raise RuntimeError('Idle service unavailable. Run pixel-activate first.')
        subprocess.run(['systemctl','--user','start' if enabled else 'stop',UNIT],check=True)
        enabled=not enabled
        subprocess.run(['notify-send','-a','Pixel Shell','Caffeine','Enabled · automatic locking paused' if enabled else 'Disabled · automatic locking resumed'])
        return
    print(json.dumps({'text':'\U000f00f2' if enabled else '\U000f06ca','class':'on' if enabled else 'off','tooltip':'Caffeine '+('ON · automatic locking paused' if enabled else 'OFF · automatic locking enabled')+'\nClick to toggle · locking before suspend remains enabled'}))
if __name__=='__main__':
    try:main()
    except (RuntimeError,subprocess.SubprocessError) as e:print(str(e),file=sys.stderr);sys.exit(1)
