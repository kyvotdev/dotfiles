background-color=#151718f5
text-color=#cedbe0
border-color=#363d40
progress-color=over #7fc0db40
font=JetBrainsMono Nerd Font 10
border-size=1
border-radius=4
padding=14,16
margin=6,12
width=380
height=170
max-visible=3
max-history=100
default-timeout=30000
ignore-timeout=1
anchor=top-right
outer-margin=34,0,0,0
icons=1
max-icon-size=36
icon-location=left
text-alignment=left
group-by=app-name,summary
format=<span size="small" alpha="49151">%a</span>\n<b>%s</b>\n%b
on-button-left=invoke-default-action
on-button-middle=exec makoctl menu -n "$id" -- fuzzel --dmenu --prompt "Action > "
on-button-right=dismiss
[urgency=low]
default-timeout=30000
[urgency=critical]
border-color=#d4bc73
default-timeout=0
border-size=2
[grouped]
format=<span size="small" alpha="49151">%a · %g messages</span>\n<b>%s</b>\n%b
[mode=do-not-disturb]
invisible=1
