[Unit]
Description=Pixel Shell automatic locking and display power saving
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/swayidle -w timeout 300 'swaylock -f' timeout 600 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors'
Restart=on-failure
RestartSec=5
